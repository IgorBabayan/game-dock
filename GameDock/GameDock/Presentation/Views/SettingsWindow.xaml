<Window x:Class="GameDock.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:GameDock.Presentation.ViewModels"
        xmlns:toastViews="clr-namespace:GameDock.Presentation.Views.Toasts"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="Settings"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Height="39"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            Command="{Binding CancelCommand}" />
                    <TextBlock Margin="18,0,0,0" Style="{StaticResource MonoLabelStyle}" Text="SETTINGS"
                               Foreground="{DynamicResource WindowForegroundBrush}" />
                </DockPanel>
            </Border>

            <!-- Updates -->
            <StackPanel Grid.Row="1" Margin="24,22,24,8">
                <TextBlock Style="{StaticResource MonoLabelStyle}" Text="GAME DOCK UPDATES" Margin="0,0,0,14"
                           Foreground="{DynamicResource MutedForegroundBrush}" />

                <CheckBox Content="Update Game Dock automatically on start" IsChecked="{Binding AutoUpdate}" />
                <TextBlock Margin="28,4,0,0" Style="{StaticResource SecondaryTextStyle}"
                           Text="Checks the latest GitHub release, downloads it and restarts into the new version." />

                <DockPanel Margin="0,18,0,0">
                    <TextBox DockPanel.Dock="Right"
                             Width="80"
                             Style="{StaticResource SearchTextBoxStyle}"
                             HorizontalContentAlignment="Right"
                             AutomationProperties.Name="Seconds before restart"
                             Text="{Binding RestartDelayText, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" Text="Seconds before restart" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                            <Run Text="Countdown after an update was downloaded (0 –" /><Run Text="{Binding MaxRestartDelaySeconds, Mode=OneWay}" /><Run Text=")." />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource ErrorForegroundBrush}"
                           Visibility="{Binding IsRestartDelayInvalid, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="Enter a number from 0 to" /> <Run Text="{Binding MaxRestartDelaySeconds, Mode=OneWay}" /><Run Text="." />
                </TextBlock>

                <Border Margin="0,20,0,0" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MonoLabelStyle}" Text="{Binding CurrentVersionText}"
                                   Foreground="{DynamicResource WindowForegroundBrush}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource OutlineButtonStyle}" Content="CHECK FOR UPDATES"
                                    Command="{Binding CheckForUpdatesCommand}" />
                            <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="DOWNLOAD AND UPDATE"
                                    Command="{Binding DownloadAndUpdateCommand}"
                                    Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding AvailableUpdateText}"
                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                   Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"
                                   Text="This copy was not installed with the installer, so it cannot update itself."
                                   Visibility="{Binding IsNotInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Margin="24,16,24,24" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Style="{StaticResource OutlineButtonStyle}" Content="CANCEL" Command="{Binding CancelCommand}" />
                <Button Width="110" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="SAVE"
                        IsDefault="True" Command="{Binding SaveCommand}" />
            </StackPanel>

            <toastViews:ToastHost Grid.Row="0" Grid.RowSpan="3" />
        </Grid>
    </Border>
</Window>
