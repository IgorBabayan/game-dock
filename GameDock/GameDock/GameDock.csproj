<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- Cross-platform: Windows, Linux and macOS (Avalonia UI). -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>GameDock</AssemblyName>
        <RootNamespace>GameDock</RootNamespace>
        <Product>App Launcher</Product>
        <!-- Shown by Windows as the exe's "File description" (Task Manager, taskbar, "Open with"). -->
        <AssemblyTitle>App Launcher</AssemblyTitle>
        <Description>App Launcher</Description>
        <Company>IgorBabayan</Company>
        <!-- Major.Minor for releases; CI appends the build number as the patch part. -->
        <VersionPrefix>0.1.0</VersionPrefix>
        <ApplicationIcon>App.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <!-- Compiled (reflection-free) bindings everywhere: faster startup and binding updates, errors at build time. -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

        <!-- The UI is English only: don't ship the framework's satellite resource assemblies. -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <!-- Precompile (ReadyToRun) when publishing for a specific runtime: much less JIT work on every start. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="11.3.23" />
      <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
      <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>

    <ItemGroup>
      <!-- Embedded so XAML and code can load them with avares:// URIs: window icon, title bar logo and the app icons on the cards. -->
      <AvaloniaResource Include="App.ico" />
      <AvaloniaResource Include="Assets\**\*.png" />
    </ItemGroup>

</Project>
